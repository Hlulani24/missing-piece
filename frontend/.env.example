# Leave unset for local dev — Vite's dev server proxy (see vite.config.js) forwards
# /api requests to your local backend on port 5000.
#
# Set this before deploying to production, to your deployed backend's URL + /api,
# e.g. https://missing-piece-api.onrender.com/api
VITE_API_URL=

# Used to build "DM to order" WhatsApp links. Digits only, country code first, no
# +, spaces or leading zero — 067 743 2782 becomes 27677432782.
VITE_WHATSAPP_NUMBER=27677432782
VITE_STORE_EMAIL=missingpiece@gmail.com
