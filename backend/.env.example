# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://localhost:27017/missing-piece

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS) - set this to your deployed frontend URL in production
CLIENT_URL=http://localhost:5173

# This backend's own public URL (used to build local-disk image URLs in dev/fallback mode)
BACKEND_PUBLIC_URL=http://localhost:5000

# One-time admin account created by `npm run seed`
ADMIN_NAME=Missing Piece Admin
ADMIN_EMAIL=missingpiece@gmail.com
ADMIN_PASSWORD=change_this_password

# Store contact details (used in a couple of API responses / emails if you add them later)
STORE_WHATSAPP_NUMBER=27677432782
STORE_EMAIL=missingpiece@gmail.com

# Cloudinary (leave blank to fall back to local disk storage in /uploads — fine for local
# dev, but Render's filesystem is wiped on every redeploy, so set these before going live)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
